# Lemon Squeezy API
# app.lemonsqueezy.com → Settings → API
LEMONSQUEEZY_API_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9...

# Webhook imzalama anahtarı
# app.lemonsqueezy.com → Settings → Webhooks → Secret
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret

# SQLite veritabanı dosyası (mutlak yol veya göreceli)
DATABASE_URL=./data/licenses.db

# Sunucu portu
PORT=3000

# Lemon Squeezy Ürün Variant ID'leri
# Her ürün için Lemon Squeezy dashboard'dan alınır:
# Variants sekmesi → ID
LS_VARIANT_TRENDYOL=12345
LS_VARIANT_HEPSIBURADA=12346
LS_VARIANT_GITHUB_PRO=12347
LS_VARIANT_ANALYTICS=12348
LS_VARIANT_BUNDLE=12349

# Opsiyonel: Yönetim API anahtarı (cron, admin endpoint'leri için)
ADMIN_API_KEY=gizli-admin-anahtari
